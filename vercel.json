{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/shared/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/grill-admin/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "rewrites": [
    { "source": "/", "destination": "/restaurants/grill-house/index.html" },
    { "source": "/r/:slug([a-z0-9-]+)", "destination": "/restaurants/:slug/index.html" },
    { "source": "/r/:slug([a-z0-9-]+)/", "destination": "/restaurants/:slug/index.html" }
  ]
}
